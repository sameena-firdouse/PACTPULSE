# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# HINDSIGHT_API_KEY: API key for Vectorize Hindsight long-term agent memory.
# Get your key at https://hindsight.vectorize.io/
HINDSIGHT_API_KEY="YOUR_HINDSIGHT_API_KEY"

# HINDSIGHT_API_URL: Vectorize Hindsight API URL (defaults to https://api.hindsight.vectorize.io)
HINDSIGHT_API_URL="https://api.hindsight.vectorize.io"

# HINDSIGHT_BANK_ID: Isolated memory bank identifier for PactPulse workforce memories
HINDSIGHT_BANK_ID="pactpulse-demo"

PORT=3000

